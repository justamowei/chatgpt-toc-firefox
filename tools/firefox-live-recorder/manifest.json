{
  "manifest_version": 3,
  "name": "ChatGPT TOC 本機實測記錄器",
  "version": "0.1.0",
  "description": "由使用者啟動，記錄目錄診斷、滾動與掛載幾何，手動下載本機 JSON。",
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["recorder.js"], "run_at": "document_idle"}],
  "browser_specific_settings": {"gecko_android": {"strict_min_version": "142.0"}, "gecko": {"id": "chatgpt-toc-live-recorder@local.codex", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}
}
