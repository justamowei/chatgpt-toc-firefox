{
  "manifest_version": 3,
  "name": "ChatGPT 對話導航器",
  "description": "在本機收錄提問、搜尋與導航 ChatGPT 對話，明確顯示歷史索引範圍。",
  "version": "0.3.5",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "開啟 ChatGPT 對話目錄"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "gecko": {
      "id": "chatgpt-toc@local.codex",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
